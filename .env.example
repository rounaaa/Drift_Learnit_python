DEBUG=True
SECRET_KEY=django-insecure-learnit-secret-key-change-in-production

# PostgreSQL Database Configuration
DB_NAME=learnit_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Google Gemini API
GEMINI_API_KEY=

# Video AI generation (Celery runs eagerly by default; set false to use Redis)
CELERY_TASK_ALWAYS_EAGER=True
CELERY_BROKER_URL=redis://localhost:6379/0
# Optional shared Redis cache; when eager mode is off, the Redis broker is reused by default.
VIDEO_AI_CACHE_URL=
VIDEO_SUMMARY_MAX_FILE_SIZE=52428800
VIDEO_SUMMARY_MAX_DURATION_SECONDS=600
